{
  "name": "money-keeper",
  "version": "2.14.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "docker run --rm -e CI=true -v \"$PWD:/work\" -v money-keeper-node-modules:/work/node_modules -v money-keeper-pnpm-store:/pnpm/store -w /work mcr.microsoft.com/playwright:v1.63.0-noble bash -lc \"corepack enable && pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile && pnpm exec playwright test \\\"\\$@\\\"\" --",
    "test:linux": "playwright test",
    "test:headed": "playwright test --headed",
    "test:codegen": "npx playwright codegen http://localhost:5173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "tsc --noemit && prettier --check . && eslint ./src",
    "tsc": "tsc --noemit",
    "eslint": "eslint ./src",
    "format": "prettier --write .",
    "generate:icons": "node ./pack-icons.js && prettier --write ./src/lib/icons.ts",
    "generate:prisma": "npx prisma generate",
    "generate": "npm run generate:icons && npm run generate:prisma"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@iconify/svelte": "^5.2.2",
    "@iconify/utils": "^3.1.6",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@ya-erm/svelte-ui": "^0.0.16",
    "autoprefixer": "^10.5.5",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prisma": "^6.19.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-i18n": "^4.0.1",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@vercel/analytics": "^2.0.1",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.23",
    "idb": "^8.0.3",
    "svelte-dnd-action": "^0.9.79",
    "timezones-list": "^3.1.0",
    "uuid": "^14.0.2"
  },
  "type": "module",
  "overrides": {
    "@sveltejs/kit": {
      "cookie": ">=0.7.0 <2"
    },
    "serialize-javascript": ">=7.0.3"
  },
  "pnpm": {
    "overrides": {
      "cookie": ">=0.7.0 <2",
      "serialize-javascript": ">=7.0.3"
    }
  },
  "packageManager": "pnpm@9.7.0+sha256.b35018fbfa8f583668b2649e407922a721355cd81f61beeb4ac1d4258e585559"
}
