{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "module": "esnext",
    "sourceMap": true,
    "strict": true,
    "rootDir": "/",
    "paths": { "@tests/*": ["./tests/*"] }
  },
  "include": [
    "global.d.ts",
    "./vite.config.ts",
    "./src/**/*.js",
    "./src/**/*.ts",
    "./src/**/*.svelte",
    "./tests/**/*.js",
    "./tests/**/*.ts",
    "./tests/**/*.svelte"
  ],
  "exclude": ["node_modules", "src/service-worker"]
}
