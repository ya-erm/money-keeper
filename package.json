{
  "name": "money-keeper",
  "version": "2.32.4",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "docker run --rm -e CI=true -v \"$PWD:/work\" -v money-keeper-node-modules:/work/node_modules -v money-keeper-pnpm-store:/pnpm/store -w /work mcr.microsoft.com/playwright:v1.64.1-noble bash -lc \"corepack enable && pnpm config set store-dir /pnpm/store && pnpm install --frozen-lockfile && pnpm exec playwright test \\\"\\$@\\\"\" --",
    "test:linux": "playwright test",
    "test:unit": "vitest run",
    "test:headed": "playwright test --headed",
    "test:codegen": "npx playwright codegen http://localhost:5173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "tsc --noemit && prettier --check . && eslint ./src",
    "tsc": "tsc --noemit",
    "eslint": "eslint ./src",
    "format": "prettier --write .",
    "generate:icons": "node ./pack-icons.js && prettier --write ./src/lib/icons.ts",
    "generate:prisma": "npx prisma generate",
    "generate": "npm run generate:icons && npm run generate:prisma"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@iconify/svelte": "^5.2.3",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@ya-erm/svelte-ui": "^0.0.16",
    "autoprefixer": "^10.6.2",
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prisma": "^6.19.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-i18n": "^4.0.1",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cheerio": "1.2.0",
    "dayjs": "^1.11.23",
    "idb": "^8.0.4",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "svelte-dnd-action": "^0.9.80",
    "timezones-list": "^3.1.0",
    "uuid": "^14.0.3",
    "zxing-wasm": "3.1.6"
  },
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "svelte-i18n": {
      "esbuild": "0.28.2"
    },
    "serialize-javascript": ">=7.0.3"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config>deepmerge-ts": "8.0.2",
      "serialize-javascript": ">=7.0.3",
      "svelte-i18n>esbuild": "0.28.2"
    }
  },
  "packageManager": "pnpm@9.7.0+sha256.b35018fbfa8f583668b2649e407922a721355cd81f61beeb4ac1d4258e585559",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
